{
    "name": "dstrop/thumper",
    "autoload": {
        "psr-4": {
            "Thumper\\": "src/"
        }
    },
    "require": {
        "spiral/roadrunner-worker": "^3.5",
        "spiral/goridge": "^4.2"
    },
    "require-dev": {
        "php": "^8.2",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "scripts": {
        "phpcs": "vendor/bin/php-cs-fixer check --diff",
        "phpcs-fix": "vendor/bin/php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyse src --level=9"
    },
    "config": {
        "allow-plugins": {}
    }
}
